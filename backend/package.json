{
  "name": "manisha-fashions-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Manisha Fashions \u2014 Jewellery Ecommerce API (Node.js + Express + MongoDB)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx src/scripts/dev-memory.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "audit": "tsx src/scripts/audit.ts",
    "coverage": "tsx src/scripts/coverage.ts",
    "make-admin": "tsx src/scripts/makeAdmin.ts",
    "routes": "tsx src/scripts/routes.ts",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx src/scripts/seedProducts.ts",
    "postinstall": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:test": "tsx src/scripts/emailTest.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "razorpay": "^2.9.6",
    "resend": "^6.28.1",
    "typescript": "^6.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "vitest": "^5.0.1"
  }
}
