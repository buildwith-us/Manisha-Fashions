# ─────────────────────────────────────────────────────────────
# Manisha Fashions — Backend environment
# PRD 8.5 / 8.11: this file is a TEMPLATE. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (PRD 8.2 — MongoDB Atlas) ──
MONGODB_URI=mongodb://127.0.0.1:27017/manisha_fashions


# ── JWT (PRD 8.7) ──
# Must be a long random value. Rotate immediately if ever exposed.
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-string
JWT_ACCESS_TTL=30m
# Default idle period before OTP is required again (PRD 4.1) — admin-configurable.
JWT_REFRESH_TTL_DAYS=90

# ── Cloudinary (PRD 8.3) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manisha-fashions/products

# ── Razorpay (PRD 4.4) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Commerce settings (PRD 6 — open items, admin-tunable) ──
# COD shipping charge in paise (5000 = ₹50.00). Confirm amount with client.
COD_SHIPPING_CHARGE=5000
PREPAID_SHIPPING_CHARGE=0
CURRENCY=INR

# ── Security (PRD 8.11) ──
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_GENERAL_PER_MIN=100
TRUST_PROXY=1

# ── Google Sign-In ──
# Three OAuth client ids from Google Cloud Console (Android, iOS, Web).
# Comma-separated: each platform mints ID tokens carrying its OWN client id as
# the `aud`, so a single value would reject two platforms out of three.
# Required in production — the server refuses to boot without it.
GOOGLE_CLIENT_IDS=

# ── Transactional email (Resend) ──
# Required in production. RESEND_FROM_EMAIL must be on a domain verified in
# Resend, or every send is rejected.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Password reset ──
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=5
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_LOCKOUT_MINUTES=10
# Per email AND per IP, enforced in the service (not the IP rate limiter).
FORGOT_PASSWORD_MAX_PER_HOUR=3

# ── Admin access ──
# Comma-separated whitelist. Re-evaluated on EVERY sign-in, so adding or
# removing an address takes effect on that account's next login — including
# demotion. Treat as a credential: anyone who can sign in as a listed
# address gets full admin.
ADMIN_EMAILS=

# ── Seed / bootstrap admin ──
# Phone+OTP login was removed, so the first admin signs in with these.
# Change the password immediately after the first login.
SEED_ADMIN_EMAIL=admin@manishafashions.in
SEED_ADMIN_PASSWORD=ChangeMe123
