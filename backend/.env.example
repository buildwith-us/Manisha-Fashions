# ─────────────────────────────────────────────────────────────
# Manisha Fashions — Backend environment
# PRD 8.5 / 8.11: this file is a TEMPLATE. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database (PRD 8.2 — MongoDB Atlas) ──
MONGODB_URI=mongodb://127.0.0.1:27017/manisha_fashions


# ── JWT (PRD 8.7) ──
# Must be a long random value. Rotate immediately if ever exposed.
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-string
JWT_ACCESS_TTL=30m
# Default idle period before OTP is required again (PRD 4.1) — admin-configurable.
JWT_REFRESH_TTL_DAYS=90

# ── OTP (PRD 8.7) ──
# Provider: console | msg91
# "console" prints the OTP to the server log — dev only, never in production.
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── Cloudinary (PRD 8.3) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manisha-fashions/products

# ── Razorpay (PRD 4.4) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ⚠️ TEMPORARY — phones allowed to use the console OTP provider in production,
# comma-separated. Their code comes back in the API response, so anyone who
# knows one of these numbers can sign in as it. Leave blank once MSG91 is live.
# Defaults to the two numbers hardcoded in otp.service.ts when unset.
OTP_TEST_PHONES=

# ── Commerce settings (PRD 6 — open items, admin-tunable) ──
# COD shipping charge in paise (5000 = ₹50.00). Confirm amount with client.
COD_SHIPPING_CHARGE=5000
PREPAID_SHIPPING_CHARGE=0
CURRENCY=INR

# ── Security (PRD 8.11) ──
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_GENERAL_PER_MIN=100
TRUST_PROXY=1

# ── Seed script ──
SEED_ADMIN_PHONE=+919999999999
